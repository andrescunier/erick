# Variables para el proyecto de Vercel (Settings -> Environment Variables).
# Copiar este archivo a .env (nunca commitear el real).

# El secreto que cualquier sync le tiene que mandar como
# "Authorization: Bearer <valor>" para poder escribir en /api/dashboards/*.
# Inventalo vos (ej. openssl rand -hex 32) y cargalo igual en Vercel.
INGEST_API_KEY=

# Personal Access Token de GitHub (fine-grained, scope "Contents: read and
# write" solo sobre este repo) — con esto la API commitea los JSON de cada
# dashboard en vez de necesitar una base de datos.
GITHUB_TOKEN=

# owner/repo de este proyecto.
GITHUB_REPO=andrescunier/erick

# Rama donde se escriben los dashboards. Default: master.
GITHUB_BRANCH=master

# Basic Auth para ver el dashboard en el navegador (no protege /api/*, que
# usa INGEST_API_KEY). Sin esto configurado, la app rechaza todo acceso.
VIEWER_USER=
VIEWER_PASSWORD=
